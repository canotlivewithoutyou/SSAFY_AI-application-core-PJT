# Application
APP_ENV=local
DATABASE_PATH=backend/data/planner.db
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
REPLAN_LIMIT=5
UPSTREAM_TIMEOUT_SECONDS=10

# LLM (example key format: sk-...; example model format: gpt-...)
OPENAI_API_KEY=
OPENAI_MODEL=
# Required when OPENAI_API_KEY is a SSAFY GMS key (otherwise requests go to api.openai.com and fail with 401)
# OPENAI_API_BASE=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# Kakao Local + Kakao Mobility (REST API key string)
KAKAO_REST_API_KEY=

# National Emergency Medical Center / data.go.kr (decoded or encoded service key)
NMC_SERVICE_KEY=

